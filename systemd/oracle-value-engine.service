[Unit]
Description=HOPE EVA paper value betting scanner
Wants=network-online.target
After=network-online.target oracle-cockpit-fetch.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ORACLE_EVA
ExecStart=/usr/bin/python3 /opt/ORACLE_EVA/value_engine.py
EnvironmentFile=-/etc/oracle-value-engine.env
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
